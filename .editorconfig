root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Endpoint-side scripts are read by Windows PowerShell 5.1 and may be uploaded
# with signature enforcement, which rejects a BOM. Keeping every script ASCII
# makes the BOM question moot - see Templates/Remediation/README.md.
[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
end_of_line = lf

[*.{json,jsonc}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Tools/Hooks/*]
end_of_line = lf

[*.{cmd,bat}]
end_of_line = crlf
